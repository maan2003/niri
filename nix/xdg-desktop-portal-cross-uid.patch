xdg-desktop-portal identifies a caller by opening /proc/<pid>/root to look for
.flatpak-info, which only works when the caller shares the portal's UID (or the
portal is root). Here every caller (the bridge) is another UID behind hidepid,
so the open fails with ENOENT or EACCES. Treat that as "not a flatpak": there
is no Flatpak on this system, and the portal never shares a UID with anyone.

--- a/src/xdp-app-info-flatpak.c
+++ b/src/xdp-app-info-flatpak.c
@@ -651,6 +651,14 @@ open_flatpak_info (int      pid,
   root_fd = openat (AT_FDCWD, root_path, O_RDONLY | O_NONBLOCK | O_DIRECTORY | O_CLOEXEC | O_NOCTTY);
   if (root_fd == -1)
     {
+      if (errno == EACCES || errno == ENOENT)
+        {
+          /* Another UID's process (drv): not ours to inspect, and never a flatpak. */
+          g_set_error (error, XDP_APP_INFO_ERROR, XDP_APP_INFO_ERROR_WRONG_APP_KIND,
+                       "Not a flatpak (root not visible from this uid)");
+          return -1;
+        }
+
       if (errno == EACCES)
         {
           struct statfs buf;
