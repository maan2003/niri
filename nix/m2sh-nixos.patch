       build_seconds=$((SECONDS - build_start))
 
       printf '%s\t%s\t%s\n' \
@@ -131,13 +136,20 @@
         stage="$state/.stage"
         rm -rf "$stage"
         mkdir -p "$stage/bin"
-        # Line tables go to a companion file; the shipped binary keeps
-        # .symtab so backtraces on the device still have function names.
+        # Line tables go to a companion file (niri's; the services are small
+        # enough to keep theirs); every shipped binary keeps .symtab so
+        # backtraces on the device still have function names.
         debug_file="$state/niri_''${version}.debug"
         llvm-objcopy --only-keep-debug "$binaries/niri" "$debug_file"
         install -m 0755 "$binaries/niri" "$stage/bin/niri"
         llvm-objcopy --strip-debug \
           --add-gnu-debuglink="$debug_file" "$stage/bin/niri"
+        for b in "$binaries"/drv-* "$binaries"/*-probe; do
+          [ -f "$b" ] && [ -x "$b" ] || continue
+          case "$b" in *.d) continue;; esac
+          llvm-objcopy --strip-debug "$b" "$stage/bin/$(basename "$b")"
+          chmod 0755 "$stage/bin/$(basename "$b")"
+        done
         # Session script, systemd units, desktop file, portal config and the
         # default config ship raw; pkgs/niri-bin.nix installs them the same
         # way pkgs/niri.nix does from a source checkout.
