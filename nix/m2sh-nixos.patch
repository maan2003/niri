@@ -116,9 +116,14 @@
       cd "$repo"
       build_start="$SECONDS"
       # Same feature set as pkgs/niri.nix, spelled out so branches with
-      # different defaults produce the same binary.
+      # different defaults produce the same binary. The desktop's services
