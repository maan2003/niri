// Minimal isolated desktop: no global session integration or auto-start programs.
animations { off; }
hotkey-overlay { skip-at-startup; }
xwayland-satellite { off; }
// Remote pointer entry must not toggle the overview.
gestures {
    hot-corners { off; }
}
prefer-no-csd
cursor { xcursor-theme "Adwaita"; }
layout {
    gaps 0
    default-column-width { proportion 1.0; }
    background-color "#20242a"
}
